```gitignore
# ==========================================
# Java / Maven / Spring Boot
# ==========================================

HELP.md
**/target/
**/build/
**/out/
**/*.class

# Maven Wrapper
backend/.mvn/wrapper/maven-wrapper.jar

# ==========================================
# Angular / Node.js
# ==========================================

**/node_modules/
**/dist/
**/.angular/cache/
**/coverage/
**/out-tsc/
**/npm-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Angular / TypeScript generated output
**/tmp/
**/bazel-out/
**/*.tsbuildinfo

# ==========================================
# IDEs / Editors
# ==========================================

# IntelliJ IDEA
.idea/
**/*.iml
**/*.iws
**/*.ipr

# Eclipse / Spring Tool Suite
.classpath
.project
.settings/
.factorypath
.apt_generated/
.springBeans
.sts4-cache/

# NetBeans
/nbproject/private/
**/nbbuild/
**/nbdist/
**/.nb-gradle/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/

# ==========================================
# Environment variables / secrets
# ==========================================

.env
.env.*
!.env.example

# ==========================================
# Logs / temporary files
# ==========================================

**/*.log
**/tmp/
**/temp/
**/connect.lock
**/libpeerconnection.log
**/testem.log
**/__screenshots__/

# ==========================================
# Operating system files
# ==========================================

.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# Miscellaneous
# ==========================================

.sass-cache/
```